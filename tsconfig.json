{
  // The page: src/ts/*.ts compiles file-for-file to src/js/*.js, which the panel loads as-is
  // (no bundler). src/js/dice.js is hand-kept (ported verbatim from Roll) and typed by
  // src/ts/dice.d.ts.
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2022", "dom", "dom.iterable"],
    "types": [],
    "rootDir": "src/ts",
    "outDir": "src/js",
    "strict": true,
    "noImplicitReturns": true,
    // Sources import each other as ./x.ts, so Node can run them directly for the tests;
    // tsc rewrites the specifiers to ./x.js on emit.
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    // Only syntax Node can strip: no enums, namespaces or parameter properties.
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "include": ["src/ts"]
}
